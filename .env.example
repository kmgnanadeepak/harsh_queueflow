# ---------------------------------------------------------------------------
# QueueFlow environment template
#
# Copy to .env and fill in real values. NEVER commit the .env file.
# Every value below is read by the backend through the ${VAR} placeholders in
# backend/src/main/resources/application.yml.
# ---------------------------------------------------------------------------

# --- Runtime profile ---------------------------------------------------------
# dev  = local defaults, schema auto-updated, demo data seeded
# h2   = zero-setup in-memory database (overrides the MySQL datasource)
# prod = production settings, refuses to start without a JWT secret, no seeding
SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8080

# --- MySQL (production and the docker-compose stack) -----------------------
DATABASE_URL=jdbc:mysql://localhost:3306/queueflow?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=queueflow
DATABASE_PASSWORD=change-me-in-production
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
# Set to "none" to stop Hibernate managing the schema (Flyway/Liquibase instead).
DDL_AUTO=update

# --- JWT ---------------------------------------------------------------------
# MUST be at least 32 characters for HS256. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=queueflow
JWT_EXPIRATION=8h

# --- Frontend (CORS + where Google redirects back to) -----------------------
FRONTEND_URL=http://localhost:5173
FRONTEND_OAUTH_CALLBACK_PATH=/auth/callback
# Comma separated list of browser origins allowed to call the API.
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173

# --- Google OAuth2 / OIDC ----------------------------------------------------
# Leave both blank to disable the Google button entirely: the app still boots and
# GET /api/auth/google/status reports {"enabled": false}.
# Create credentials at https://console.cloud.google.com/apis/credentials and add
# the authorised redirect URI: {FRONTEND_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to {baseUrl}/login/oauth2/code/{registrationId}.
GOOGLE_REDIRECT_URI=

# --- Queue algorithm ---------------------------------------------------------
# A token gains one priority rank after every AGEING_INTERVAL_MINUTES of waiting,
# up to AGEING_MAX_BOOST ranks, so nobody is starved by higher priority cases.
QUEUE_AGEING_INTERVAL_MINUTES=15
QUEUE_AGEING_MAX_BOOST=2
# Notify a customer when at most this many people are ahead of them.
QUEUE_APPROACHING_THRESHOLD=2
QUEUE_SCAN_INTERVAL_MS=60000

# --- Demo data ---------------------------------------------------------------
# Idempotent demo organizations, services, counters and accounts.
# Always false in production.
SEED_DATA_ENABLED=true

# --- Frontend (Vite) ---------------------------------------------------------
# Leave empty so the dev server proxies /api and /ws to the backend on 8080.
# Set to the absolute API URL when the frontend and API are on different hosts.
VITE_API_BASE_URL=

# --- Docker Compose only -----------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
